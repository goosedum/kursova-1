@startuml
' Діаграма прецедентів — функції аналізу 1–6 і довідка (крок 3.1). Джерело — docs/analysis/04-use-cases.md, розділи 3–4.
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 200
skinparam usecase {
  BackgroundColor white
}
left to right direction

actor "Користувач" as User

rectangle "Каталог вакансій: аналіз" {
  usecase "UC-11 Ф.1\nЗнайти за посадою і компанією" as UC11
  usecase "UC-12 Ф.2\nЗнайти за технологією" as UC12
  usecase "UC-13 Ф.3\nВідібрати за рівнем і форматом" as UC13
  usecase "UC-14 Ф.4\nВідсортувати за середньою\nзарплатою (сортування злиттям)" as UC14
  usecase "UC-15 Ф.5\nЗнайти мін. і макс.\nдіапазон зарплати" as UC15
  usecase "UC-16 Ф.6\nЗгрупувати за спеціалізацією" as UC16
  usecase "UC-17\nПереглянути довідку" as UC17
  usecase "UC-21\nПоказати повідомлення\nпро помилку" as UC21
}

User -- UC11
User -- UC12
User -- UC13
User -- UC14
User -- UC15
User -- UC16
User -- UC17

UC14 <.. UC21 : <<extend>>\nкаталог порожній
UC15 <.. UC21 : <<extend>>
UC16 <.. UC21 : <<extend>>
@enduml
