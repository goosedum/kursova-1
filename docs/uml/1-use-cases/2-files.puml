@startuml
' Діаграма прецедентів — робота з файлами (крок 3.1). Джерело — docs/analysis/04-use-cases.md, розділи 3–4.
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 200
skinparam usecase {
  BackgroundColor white
}
left to right direction

actor "Користувач" as User

rectangle "Каталог вакансій: файли" {
  usecase "UC-22\nПопередити про\nнезбережені зміни" as UC22
  usecase "UC-01\nСтворити новий\n(порожній) каталог" as UC01
  usecase "UC-02\nВідкрити каталог з файлу" as UC02
  usecase "UC-19\nПеревірити формат\nрядка файлу" as UC19
  usecase "UC-18\nПеревірити дані вакансії" as UC18
  usecase "UC-03\nЗберегти каталог" as UC03
  usecase "UC-04\nЗберегти каталог як…" as UC04
  usecase "UC-21\nПоказати повідомлення\nпро помилку" as UC21
}

User -- UC01
User -- UC02
User -- UC03
User -- UC04

UC02 ..> UC19 : <<include>>
UC02 ..> UC18 : <<include>>
UC01 <.. UC22 : <<extend>>
UC02 <.. UC22 : <<extend>>
UC04 .[norank].> UC03 : <<extend>>\nфайлу ще немає
UC02 <.. UC21 : <<extend>>\nфайл не прочитано\nабо помилковий рядок
UC03 <.. UC21 : <<extend>>
UC04 <.. UC21 : <<extend>>
@enduml
