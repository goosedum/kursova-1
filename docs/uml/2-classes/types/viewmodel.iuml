' Шар ViewModel — стан вікна. Підключається з діаграм у docs/uml/2-classes (крок 3.2). Джерело — .claude/plan/02-architecture.md §3.
package "ViewModel" {
  class CatalogViewModel {
    + catalog : VacancyCatalog
    + operations : [CatalogOperation]
    + selectedOperation : CatalogOperation?
    + result : OperationResult?
    + selectedVacancyIDs : Set<UUID>
    + editingDraft : Vacancy?
    + isFormPresented : Bool
    + currentFileURL : URL?
    + hasUnsavedChanges : Bool
    + errorAlert : VacancyError?
    + isDeleteConfirmationPresented : Bool
    + isSavePanelPresented : Bool
    - editingOriginal : Vacancy?
    - isDemoCatalog : Bool {readOnly}
    + /displayedGroups : [VacancyGroup]
    + /selectedVacancies : [Vacancy]
    + /canEditSelected : Bool
    + /canDeleteSelected : Bool
    + /isEditingExisting : Bool
    + /deleteConfirmationTitle : String
    + /deleteConfirmationMessage : String
    + /catalogName : String
    + /windowSubtitle : String
    + /statusText : String
    + /highlightedTechnology : String
    + /isCatalogEmpty : Bool
    + /isNothingFound : Bool
    --
    + select(_ operation: CatalogOperation)
    + showAll()
    + run(_ operation: CatalogOperation)
    + newVacancy()
    + editSelected()
    + duplicateSelected()
    + deleteSelected()
    + saveDraft()
    + cancelEditing()
    + newCatalog()
    + open(url: URL)
    + save()
    + saveAs(url: URL)
    + loadDemoData()
    - closeForm()
    - refreshResult()
    - withAccess(to url: URL, _ action: () throws -> Void)
    - showError(_ error: Error)
    - lowercasedFirstLetter(_ text: String) : String
  }
}
