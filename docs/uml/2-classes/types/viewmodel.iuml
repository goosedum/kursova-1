package "ViewModel" {
  class CatalogViewModel {
    + catalog : VacancyCatalog
    + operations : [CatalogOperation]
    + selectedOperation : CatalogOperation?
    + result : OperationResult?
    + selectedVacancyIDs : Set<UUID>
    + editingDraft : Vacancy?
    + isFormPresented : Bool
    + currentFileURL : URL?
    + hasUnsavedChanges : Bool
    + errorAlert : VacancyError?
    + isDeleteConfirmationPresented : Bool
    --
    + showAll()
    + run(_ operation: CatalogOperation)
    + newVacancy()
    + editSelected()
    + duplicateSelected()
    + deleteSelected()
    + saveDraft()
    + newCatalog()
    + open(url: URL)
    + save()
    + saveAs(url: URL)
    + loadDemoData()
  }
}
